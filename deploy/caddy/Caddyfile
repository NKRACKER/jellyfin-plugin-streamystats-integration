media.example.com {
    reverse_proxy jellyfin:8096
}

stats.media.example.com {
    handle {
        reverse_proxy streamystats:3000 {
            header_down -X-Frame-Options
            # Add a separate restrictive CSP. If Streamystats later starts sending
            # a conflicting frame-ancestors policy, embedding fails safely.
            header_down +Content-Security-Policy "frame-ancestors 'self' https://media.example.com"
            header_down X-Content-Type-Options nosniff
            header_down Referrer-Policy strict-origin-when-cross-origin
        }
    }
}
